      "id": "real-office",
      "title": "Pangolin's office Wi-Fi",
      "explanation": "Company Pangolin adopted RFC 9704: its zone zivkovic.me is DNSSEC-signed at Cloudflare and publishes a Verification Record authorising dns.splittrust.zivkovic.me for internal.splittrust.zivkovic.me. Pangolin's devices verify the office network's claim against the real DNS before using the office resolver for those names.",
      "discovery": "dnr",
      "parent": "zivkovic.me",
      "network_resolvers": [
        {
          "adn": "dns.splittrust.zivkovic.me",
          "addr": "172.30.97.20:853"
        }
      ],
      "claims": [
        {
          "resolver": "dns.splittrust.zivkovic.me",
          "subdomains": [
            "internal.splittrust"
          ],
          "ds": "none",
          "salt": "ef3XgSkZTxuXMH18506K5Q"
        }
      ],
      "pvd_id": "pvd.splittrust.zivkovic.me",
      "default_device": "validating-stub",
      "example_qname": "host.internal.splittrust.zivkovic.me",
      "expected": [
        {
          "device": "validating-stub",
          "decision": "accepted",
          "reason": "AUTHORIZED"
        },
        {
          "device": "private-dns",
          "decision": "accepted",
          "reason": "EXTERNAL_TOKEN_MATCH"
        },
        {
          "device": "hybrid",
          "decision": "accepted",
          "reason": "AUTHORIZED"
        }
      ]
    },
