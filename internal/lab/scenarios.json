          "ds": "none"
        }
      ],
      "pvd_id": "wifi.hotel.lab",
      "default_device": "validating-stub",
      "example_qname": "www.zivkovic.me",
      "expected": [
        {
          "device": "validating-stub",
          "decision": "rejected",
          "reason": "DNSSEC_BOGUS"
        },
        {
          "device": "private-dns",
          "decision": "rejected",
          "reason": "RECORD_MISSING"
        }
      ]
    },
